---
// Screenshot slider. Cross-fades every 4.5 s and pauses on hover or focus.
// With "reduce motion" turned on it switches without the fade, every 7 s.
// `controls` adds previous/next buttons and dots (used on case-study pages).
interface Props { images: { src: string; caption: string }[]; title: string; controls?: boolean }
const { images, title, controls = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<figure class="gallery relative" data-gallery aria-roledescription="carousel" aria-label={`${title} screenshots`}>
  <div class="relative aspect-[1568/778] overflow-hidden rounded-xl border border-line bg-surface-2">
    {images.map((img, i) => (
      <img
        src={`${base}/projects/${img.src}`}
        alt={img.caption}
        width="1568" height="778"
        loading={i === 0 ? 'eager' : 'lazy'}
        decoding="async"
        class:list={['gallery-slide absolute inset-0 size-full object-cover object-top transition-opacity duration-700', i === 0 ? 'opacity-100' : 'opacity-0']}
        aria-hidden={i === 0 ? 'false' : 'true'}
      />
    ))}
    {controls && (
      <>
        <button type="button" data-prev class="absolute left-3 top-1/2 z-10 grid size-10 -translate-y-1/2 place-items-center rounded-full border border-line bg-bg/80 backdrop-blur hover:border-signal" aria-label="Previous screenshot">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button type="button" data-next class="absolute right-3 top-1/2 z-10 grid size-10 -translate-y-1/2 place-items-center rounded-full border border-line bg-bg/80 backdrop-blur hover:border-signal" aria-label="Next screenshot">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </>
    )}
  </div>
  <figcaption class="mt-3 flex items-center justify-between gap-4 text-sm text-muted">
    <span data-caption aria-live="polite">{images[0]?.caption}</span>
    <span class="flex shrink-0 gap-1.5">
      {images.map((_, i) => (
        controls
          ? <button type="button" data-dot={i} class:list={['h-2 rounded-full transition-all', i === 0 ? 'w-6 bg-signal' : 'w-2 bg-line']} aria-label={`Show screenshot ${i + 1}`}></button>
          : <span data-dot={i} class:list={['h-2 rounded-full transition-all', i === 0 ? 'w-6 bg-signal' : 'w-2 bg-line']} aria-hidden="true"></span>
      ))}
    </span>
  </figcaption>
</figure>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLImageElement>('.gallery-slide')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const caption = root.querySelector<HTMLElement>('[data-caption]');
    if (slides.length < 2) return;
    let index = 0;
    let timer: number | undefined;

    const show = (n: number) => {
      index = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        s.classList.toggle('opacity-100', i === index);
        s.classList.toggle('opacity-0', i !== index);
        s.setAttribute('aria-hidden', String(i !== index));
      });
      dots.forEach((d, i) => {
        d.classList.toggle('w-6', i === index); d.classList.toggle('bg-signal', i === index);
        d.classList.toggle('w-2', i !== index); d.classList.toggle('bg-line', i !== index);
      });
      if (caption) caption.textContent = slides[index]!.alt;
    };
    const start = () => { stop(); timer = window.setInterval(() => show(index + 1), reduce ? 7000 : 4500); };
    const stop = () => { if (timer) window.clearInterval(timer); };

    root.querySelector('[data-prev]')?.addEventListener('click', () => { show(index - 1); start(); });
    root.querySelector('[data-next]')?.addEventListener('click', () => { show(index + 1); start(); });
    dots.forEach((d, i) => d.addEventListener('click', () => { show(i); start(); }));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    start();
  });
</script>
