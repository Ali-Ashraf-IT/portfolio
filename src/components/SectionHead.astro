---
// Section heading: big condensed title, then a rule ending in a dot (reference 3).
interface Props { id: string; title: string; intro?: string }
const { id, title, intro } = Astro.props;
---
<div class="mb-8" data-reveal>
  <div class="flex items-center gap-5">
    <h2 id={id} class="font-display text-5xl font-black uppercase leading-none sm:text-6xl">{title}</h2>
    <span class="relative h-px flex-1 bg-line" aria-hidden="true">
      <span class="absolute -top-1 right-0 size-2.5 rounded-full bg-glow shadow-[0_0_14px_var(--glow)]"></span>
    </span>
  </div>
  {intro && <p class="mt-3 max-w-2xl text-muted">{intro}</p>}
</div>
