---
// Section heading used by every home-page section.
interface Props { id: string; title: string; intro?: string }
const { id, title, intro } = Astro.props;
---
<div class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between" data-reveal>
  <h2 id={id} class="font-display text-5xl font-black uppercase leading-none sm:text-6xl">{title}</h2>
  {intro && <p class="max-w-md text-muted sm:text-right">{intro}</p>}
</div>
