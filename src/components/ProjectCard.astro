---
// Project tile for the home page. Large tiles show the workflow diagram.
import type { Project } from '../data/portfolio';
import Flow from './Flow.astro';
import Icon from './Icon.astro';
interface Props { project: Project; large?: boolean }
const { project: p, large = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/projects/${p.slug}/`;
const repo = p.links.find((l) => l.href.includes('github.com'));
---
<article class:list={['tile tile-hover group relative flex flex-col p-6', large && 'lg:col-span-2']} data-reveal data-category={p.category}>
  <div class="flex items-center justify-between gap-3 text-sm">
    <span class="chip font-bold text-signal">{p.category}</span>
    <span class="text-muted">{p.date}</span>
  </div>

  {p.image && (
    <img src={`${base}/projects/${p.image}`} alt={`Screenshot of ${p.title}`} loading="lazy" class="mt-5 aspect-video w-full rounded-lg border border-line object-cover" />
  )}

  <h3 class="mt-4 font-display text-3xl font-bold uppercase leading-tight sm:text-4xl">
    <!-- the whole tile is clickable through this link's ::after -->
    <a href={href} class="after:absolute after:inset-0 after:rounded-[14px] focus-visible:outline-none group-focus-within:underline">{p.title}</a>
  </h3>
  <p class="mt-3 leading-relaxed text-muted">{p.summary}</p>

  {large && <div class="mt-5"><Flow steps={p.flow} compact /></div>}

  <ul class="mt-5 flex flex-wrap gap-2" aria-label="Technologies">
    {p.stack.slice(0, large ? 7 : 5).map((t) => <li class="chip">{t}</li>)}
  </ul>

  <div class="mt-auto flex flex-wrap items-center gap-4 pt-6 text-sm font-bold">
    <span class="inline-flex items-center gap-1 text-signal">Read case study <Icon name="arrow" class="size-4" /></span>
    {repo && (
      <a href={repo.href} class="relative z-10 inline-flex items-center gap-1.5 text-muted hover:text-ink" rel="noopener">
        <Icon name="github" class="size-4" /> Code
      </a>
    )}
  </div>
</article>
