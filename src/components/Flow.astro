---
// Workflow diagram as readable steps: wraps on mobile, a row on desktop.
interface Props { steps: { label: string; detail?: string }[]; compact?: boolean }
const { steps, compact = false } = Astro.props;
---
<ol class:list={['flex flex-wrap items-stretch gap-y-2', compact ? 'text-xs' : 'text-sm']} aria-label="How it works">
  {steps.map((s, i) => (
    <li class="flex items-center">
      <span class="rounded-lg border border-line bg-surface-2 px-3 py-2 leading-tight">
        <span class="block font-bold">{s.label}</span>
        {s.detail && !compact && <span class="block text-muted">{s.detail}</span>}
      </span>
      {i < steps.length - 1 && (
        <svg class="mx-1 size-4 shrink-0 text-glow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
      )}
    </li>
  ))}
</ol>
