---
// Hero: two columns. Left: name, role, focus areas, value proposition and
// buttons. Right: portrait in a glowing ring (reference 2) with a slowly
// turning text badge (reference 1). Highlight tiles underneath.
import { profile, stats } from '../data/portfolio';
import Icon from './Icon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const [first, ...rest] = profile.name.split(' ');
const initials = profile.name.split(' ').map((p) => p[0]).join('');
const badgeText = 'Network • Systems • Automation • ';
---
<section class="relative overflow-hidden" aria-labelledby="hero-name">
  <!-- soft colour wash behind the hero -->
  <div class="pointer-events-none absolute -top-40 right-[-10%] size-[42rem] rounded-full bg-signal/15 blur-[120px]" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 pt-10 pb-12 sm:px-6 sm:pt-16 lg:pt-20">
    <div class="grid items-center gap-12 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
      <!-- Text column -->
      <div class="order-2 lg:order-1">
        <p class="hero-in inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-4 py-1.5 text-sm font-semibold text-muted backdrop-blur">
          <span class="relative flex size-2.5">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-glow opacity-60 motion-reduce:hidden"></span>
            <span class="relative inline-flex size-2.5 rounded-full bg-glow"></span>
          </span>
          {profile.openTo}
        </p>

        <h1 id="hero-name" class="hero-in hero-in-2 mt-6 font-display font-black uppercase leading-[0.88] tracking-tight text-[clamp(3.6rem,13vw,7.5rem)]">
          {first} <span class="bg-gradient-to-r from-signal to-glow bg-clip-text text-transparent">{rest.join(' ')}</span>
        </h1>

        <div class="hero-in hero-in-3">
          <p class="mt-5 font-display text-2xl font-bold uppercase tracking-wide sm:text-3xl">
            {profile.role} <span class="text-muted">&middot; {profile.company}</span>
          </p>
          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Focus areas">
            {profile.focus.map((f) => <li class="chip font-semibold">{f}</li>)}
          </ul>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">{profile.tagline}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={`${base}/${profile.cv}`} download class="btn btn-primary">
              Download CV <span class="btn-badge"><Icon name="download" class="size-4" /></span>
            </a>
            <a href="#contact" class="btn btn-ghost">
              Contact me <span class="btn-badge"><Icon name="arrow" class="size-4" /></span>
            </a>
          </div>
        </div>
      </div>

      <!-- Portrait column -->
      <div class="hero-in hero-in-2 order-1 mx-auto w-full max-w-64 sm:max-w-80 lg:order-2 lg:ml-auto lg:mr-0 lg:max-w-[26rem]">
        <div class="relative">
          <div class="absolute inset-6 rounded-full bg-signal/30 blur-3xl" aria-hidden="true"></div>
          <div class="relative aspect-square rounded-full border-2 border-glow/70 p-3 shadow-[0_0_70px_-12px_var(--glow)]">
            {profile.photo ? (
              <img src={`${base}/${profile.photo}`} alt={`Portrait of ${profile.name}`} width="480" height="480" class="size-full rounded-full object-cover" loading="eager" fetchpriority="high" />
            ) : (
              <div class="grid size-full place-items-center rounded-full bg-surface font-display text-8xl font-black text-signal" role="img" aria-label={`${profile.name} monogram`}>{initials}</div>
            )}
          </div>
          <!-- Turning badge, tucked into the lower-right corner of the ring -->
          <svg class="absolute -bottom-2 -right-2 size-24 animate-[spin_24s_linear_infinite] motion-reduce:animate-none sm:size-28" viewBox="0 0 120 120" aria-hidden="true">
            <circle cx="60" cy="60" r="58" fill="var(--bg)" stroke="var(--line)" />
            <defs><path id="badge-circle" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0" /></defs>
            <text font-size="10.5" font-weight="700" letter-spacing="2.6" fill="var(--muted)" style="text-transform:uppercase">
              <textPath href="#badge-circle">{badgeText}</textPath>
            </text>
            <path d="M60 46 L63 57 L74 60 L63 63 L60 74 L57 63 L46 60 L57 57 Z" fill="var(--glow)" />
          </svg>
        </div>
      </div>
    </div>

    <!-- Highlight tiles: network, security, monitoring and automation -->
    <ul class="mt-14 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" aria-label="Highlights">
      {stats.map((s) => (
        <li class="tile flex items-start gap-4 p-5" data-reveal>
          <p class="min-w-[4.5rem] font-display text-4xl font-black leading-none text-signal">{s.value}</p>
          <div>
            <p class="font-bold leading-tight">{s.label}</p>
            <p class="mt-1 text-sm text-muted">{s.detail}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
