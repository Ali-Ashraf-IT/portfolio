---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Page not found" description="This page does not exist.">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6">
    <p class="font-display text-[clamp(6rem,30vw,14rem)] font-black leading-none text-signal">404</p>
    <h1 class="mt-4 font-display text-4xl font-bold uppercase">Page not found</h1>
    <p class="mt-3 text-muted">The link may be old or mistyped.</p>
    <a href={`${base}/`} class="btn btn-primary mt-8 pr-6">Go to the home page</a>
  </section>
</Base>
