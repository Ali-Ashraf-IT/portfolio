---
// CV page (/cv). Same data as the website, laid out as an A4 document.
// ATS-friendly: one column, real text, standard headings, no tables or icons.
// public/Ashraf_CV.pdf is printed from this page (see scripts/cv-pdf.ps1).
import '@fontsource-variable/manrope/wght';
import { profile, experience, education, certifications, languages, cv } from '../data/portfolio';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = new URL(`${base}/`, Astro.site).href.replace(/^https?:\/\//, '').replace(/\/$/, '');
const strip = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '');
const contact = [profile.location, profile.email, profile.phone, strip(profile.linkedin), strip(profile.github), site].filter(Boolean);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{profile.name} CV | {profile.role}</title>
  <meta name="description" content={`CV of ${profile.name}, ${profile.role}.`} />
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <style>
    @page { size: A4; margin: 0; }
    * { box-sizing: border-box; }
    html { background: #e8ebf0; }
    body { margin: 0; color: #111827; font-family: "Manrope Variable", Arial, sans-serif; font-size: 9.1pt; line-height: 1.32; }
    .page { width: 210mm; min-height: 297mm; margin: 24px auto; background: #fff; padding: 10mm 14mm 6mm; box-shadow: 0 10px 40px -20px rgba(0,0,0,.4); }
    header { border-bottom: 2.5pt solid #3a3f4b; padding-bottom: 8pt; }
    h1 { font-size: 23pt; line-height: 1; margin: 0; letter-spacing: -.01em; color: #1f2937; }
    .title { margin: 4pt 0 6pt; font-size: 11.5pt; font-weight: 700; color: #1a5bd6; }
    .contact { margin: 0; color: #374151; font-size: 9pt; }
    .contact { display: flex; flex-wrap: wrap; row-gap: 1pt; }
    .contact span { white-space: nowrap; } /* never break an email or URL */
    .contact span + span::before { white-space: pre; }
    .contact span + span::before { content: " | "; color: #9ca3af; }
    h2 { font-size: 10.5pt; letter-spacing: .08em; text-transform: uppercase; color: #3a3f4b; margin: 7.5pt 0 2.5pt; padding-bottom: 1.5pt; border-bottom: .75pt solid #d1d5db; }
    p { margin: 0; }
    ul { margin: 2pt 0 0; padding-left: 13pt; }
    li { margin: 1pt 0; }
    .row { display: flex; justify-content: space-between; gap: 8pt; align-items: baseline; }
    .job { margin-top: 6pt; }
    .job h3, .item h3 { font-size: 10.5pt; margin: 0; }
    .muted { color: #4b5563; }
    .date { white-space: nowrap; color: #374151; font-weight: 600; font-size: 9.5pt; }
    .skills p { margin: 1.5pt 0; }
    .item { margin-top: 4pt; }
    .print-bar { max-width: 210mm; margin: 16px auto 0; display: flex; gap: 8px; justify-content: flex-end; font-family: Arial, sans-serif; }
    .print-bar a { background: #1a5bd6; color: #fff; text-decoration: none; padding: 9px 16px; border-radius: 999px; font-weight: 700; font-size: 14px; }
    .print-bar a.ghost { background: #fff; color: #111827; border: 1px solid #d1d5db; }
    @media print { html { background: #fff; } .page { margin: 0; box-shadow: none; } .print-bar { display: none; } }
    @media screen and (max-width: 780px) { .page { width: auto; min-height: 0; margin: 12px; padding: 20px; } .row { flex-direction: column; gap: 0; } }
    /* When shown inside the home-page preview frame */
    html.embedded { background: #fff; }
    html.embedded .page { margin: 0; box-shadow: none; }
    html.embedded .print-bar { display: none; }
  </style>
  <script is:inline>if (window.self !== window.top) document.documentElement.classList.add('embedded');</script>
</head>
<body>
  <nav class="print-bar" aria-label="CV actions">
    <a class="ghost" href={`${base}/`}>Back to portfolio</a>
    <a href={`${base}/${profile.cv}`} download>Download PDF</a>
  </nav>

  <main class="page">
    <header>
      <h1>{profile.name}</h1>
      <p class="title">{profile.role}</p>
      <p class="contact">{contact.map((c) => <span>{c}</span>)}</p>
    </header>

    <section>
      <h2>Summary</h2>
      <p>{cv.summary}</p>
    </section>

    <section class="skills">
      <h2>Skills</h2>
      {cv.skills.map((g) => <p><strong>{g.group}:</strong> {g.line}</p>)}
    </section>

    <section>
      <h2>Experience</h2>
      {experience.map((job) => (
        <div class="job">
          <div class="row">
            <h3>{job.role}, {job.company}{job.place && `, ${job.place}`}</h3>
            <span class="date">{job.start} – {job.end}</span>
          </div>
          <ul>{(cv.experience[job.company] ?? job.points).map((pt) => <li>{pt}</li>)}</ul>
        </div>
      ))}
    </section>

    <section>
      <h2>Projects</h2>
      {cv.projects.map((p) => (
        <div class="item"><p><strong>{p.name}.</strong> {p.line}</p></div>
      ))}
    </section>

    <section>
      <h2>Education</h2>
      {education.map((e) => (
        <div class="item row"><h3>{e.title}, {e.place}</h3><span class="date">{e.detail}</span></div>
      ))}
    </section>

    {certifications.length > 0 && (
      <section>
        <h2>Certifications</h2>
        {certifications.map((c) => (
          <div class="item row"><p><strong>{c.title}</strong>, {c.issuer}</p>{c.year && <span class="date">{c.year}</span>}</div>
        ))}
      </section>
    )}

    <section>
      <h2>Languages</h2>
      <p>{languages.join(', ')}</p>
    </section>
  </main>
</body>
</html>
