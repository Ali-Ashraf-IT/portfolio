---
// Case-study page, one per project in src/data/portfolio.ts.
import Base from '../../layouts/Base.astro';
import Flow from '../../components/Flow.astro';
import Icon from '../../components/Icon.astro';
import { projects, profile, type Project } from '../../data/portfolio';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
interface Props { project: Project }
const { project: p } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const idx = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(idx + 1) % projects.length]!;
---
<Base title={`${p.title} | ${profile.name}`} description={p.summary}>
  <article class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16">
    <a href={`${base}/#projects`} class="text-sm font-bold text-muted hover:text-ink">&larr; All projects</a>

    <header class="mt-6">
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <span class="chip font-bold text-signal">{p.category}</span>
        <span class="text-muted">{p.date}</span>
      </div>
      <h1 class="mt-4 font-display text-6xl font-black uppercase leading-[0.9] sm:text-8xl">{p.title}</h1>
      <p class="mt-6 max-w-3xl text-xl leading-relaxed">{p.summary}</p>
      <p class="mt-4 text-sm font-semibold text-muted">My role: {p.role}</p>
      {p.links.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-3">
          {p.links.map((l) => (
            <a href={l.href} rel="noopener" class="inline-flex items-center gap-2 rounded-xl border border-line bg-surface px-5 py-3 font-bold hover:border-signal">
              <Icon name="github" class="size-5" /> {l.label}
            </a>
          ))}
        </div>
      )}
    </header>

    {p.video && (
      <div class="tile mt-10 overflow-hidden">
        <iframe class="aspect-video w-full" src={`https://www.youtube-nocookie.com/embed/${p.video}`} title={`${p.title} demo video`} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      </div>
    )}
    {p.image && !p.video && (
      <img src={`${base}/projects/${p.image}`} alt={`Screenshot of ${p.title}`} class="tile mt-10 w-full" />
    )}

    <section class="tile mt-10 p-6 sm:p-8" aria-labelledby="how">
      <h2 id="how" class="font-display text-3xl font-bold uppercase">How it works</h2>
      <div class="mt-5"><Flow steps={p.flow} /></div>
    </section>

    <div class="mt-3 grid gap-3 md:grid-cols-2">
      <section class="tile p-6 sm:p-8" aria-labelledby="problem">
        <h2 id="problem" class="font-display text-3xl font-bold uppercase">The problem</h2>
        <p class="mt-3 leading-relaxed text-muted">{p.problem}</p>
      </section>
      <section class="tile p-6 sm:p-8" aria-labelledby="built">
        <h2 id="built" class="font-display text-3xl font-bold uppercase">What I built</h2>
        <p class="mt-3 leading-relaxed text-muted">{p.built}</p>
      </section>
    </div>

    <section class="tile mt-3 p-6 sm:p-8" aria-labelledby="safe">
      <h2 id="safe" class="font-display text-3xl font-bold uppercase">Safeguards</h2>
      <ul class="mt-4 space-y-2">
        {p.safeguards.map((s) => (
          <li class="flex gap-3 leading-relaxed"><span class="mt-2.5 h-0.5 w-3 shrink-0 bg-glow" aria-hidden="true"></span><span>{s}</span></li>
        ))}
      </ul>
    </section>

    {p.results.length > 0 && (
      <section class="tile mt-3 p-6 sm:p-8" aria-labelledby="results">
        <h2 id="results" class="font-display text-3xl font-bold uppercase">Results</h2>
        <ul class="mt-4 space-y-2">{p.results.map((r) => <li>{r}</li>)}</ul>
      </section>
    )}

    <section class="tile mt-3 p-6 sm:p-8" aria-labelledby="stack">
      <h2 id="stack" class="font-display text-3xl font-bold uppercase">Tech stack</h2>
      <ul class="mt-4 flex flex-wrap gap-2">{p.stack.map((t) => <li class="chip">{t}</li>)}</ul>
    </section>

    <a href={`${base}/projects/${next.slug}/`} class="tile mt-10 flex items-center justify-between gap-4 p-6 sm:p-8">
      <span>
        <span class="block text-sm font-semibold text-muted">Next project</span>
        <span class="font-display text-3xl font-bold uppercase">{next.title}</span>
      </span>
      <Icon name="arrow" class="size-8 shrink-0 text-signal" />
    </a>
  </article>
</Base>
