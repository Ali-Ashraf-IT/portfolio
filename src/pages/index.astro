---
// Home page. Content comes from src/data/portfolio.ts.
import QRCode from 'qrcode';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { profile, skills, experience, education, certifications, languages, projects } from '../data/portfolio';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const skillIcons = ['server', 'network', 'bolt', 'shield', 'cloud', 'tool'];

// Bento pattern for project tiles: wide, narrow / narrow, wide / wide, narrow
const largeAt = new Set([0, 3, 4]);
const ordered = [...projects].sort((a, b) => Number(b.featured) - Number(a.featured));
const categories = ['All', ...new Set(ordered.map((p) => p.category))];

// QR code to LinkedIn, generated at build time (reference images 1 and 5)
const qrSvg = await QRCode.toString(profile.linkedin, {
  type: 'svg', margin: 0, color: { dark: '#0a1120', light: '#ffffff' },
});
---
<Base>
  <Hero />

  <!-- ABOUT -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6" aria-labelledby="about">
    <SectionHead id="about" title="About" />
    <div class="grid gap-3 md:grid-cols-3">
      <div class="tile p-6 md:col-span-2 md:row-span-2 sm:p-8" data-reveal>
        {profile.about.map((para) => <p class="mb-4 text-lg leading-relaxed last:mb-0">{para}</p>)}
      </div>
      <div class="tile p-6" data-reveal>
        <Icon name="cap" class="size-7 text-signal" />
        <h3 class="mt-3 font-bold">Education</h3>
        {education.map((e) => (
          <p class="mt-1 text-sm text-muted">{e.title}<br />{e.place}{e.detail && <>, {e.detail}</>}</p>
        ))}
      </div>
      <div class="tile p-6" data-reveal>
        <Icon name="pin" class="size-7 text-signal" />
        <h3 class="mt-3 font-bold">Based in {profile.location}</h3>
        <p class="mt-1 text-sm text-muted">Languages: {languages.join(', ')}</p>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6" aria-labelledby="skills">
    <SectionHead id="skills" title="Skills" intro="Grouped by what I do with them day to day." />
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {skills.map((g, i) => (
        <div class="tile p-6" data-reveal>
          <div class="flex items-center gap-3">
            <span class="grid size-12 place-items-center rounded-xl border border-line bg-surface-2 text-signal"><Icon name={skillIcons[i] ?? 'tool'} /></span>
            <div>
              <h3 class="font-display text-2xl font-bold uppercase leading-none">{g.group}</h3>
              <p class="text-sm text-muted">{g.note}</p>
            </div>
          </div>
          <ul class="mt-5 flex flex-wrap gap-2">
            {g.items.map((s) => <li class="chip">{s}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6" aria-labelledby="experience">
    <SectionHead id="experience" title="Experience" />
    <ol class="relative border-l border-line pl-6 sm:pl-10">
      {experience.map((job) => (
        <li class="relative mb-6 last:mb-0" data-reveal>
          <span class="absolute -left-[31px] top-7 size-3.5 rounded-full border-2 border-bg bg-signal ring-4 ring-signal/20 sm:-left-[47px]" aria-hidden="true"></span>
          <div class="tile p-6 sm:p-8">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
              <h3 class="font-display text-3xl font-bold uppercase leading-tight">{job.role}</h3>
              <p class="text-sm font-semibold text-muted">{job.start} to {job.end}</p>
            </div>
            <p class="font-semibold text-signal">{job.company}{job.place && `, ${job.place}`}</p>
            <ul class="mt-4 space-y-2">
              {job.points.map((pt) => (
                <li class="flex gap-3 leading-relaxed"><span class="mt-2.5 h-0.5 w-3 shrink-0 bg-glow" aria-hidden="true"></span><span>{pt}</span></li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- PROJECTS -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6" aria-labelledby="projects">
    <SectionHead id="projects" title="Projects" intro="Automation I run at work and security tools I have built. Each one has a short case study." />
    <div class="mb-6 flex flex-wrap gap-2" role="group" aria-label="Filter projects">
      {categories.map((c, i) => (
        <button type="button" class="chip px-4 py-1.5 font-semibold aria-pressed:border-signal aria-pressed:bg-signal aria-pressed:text-signal-ink" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={c}>{c}</button>
      ))}
    </div>
    <div class="grid gap-3 lg:grid-cols-3" id="project-grid">
      {ordered.map((p, i) => <ProjectCard project={p} large={largeAt.has(i)} />)}
    </div>
  </section>

  <!-- CERTIFICATIONS (hidden automatically when the list is empty) -->
  {certifications.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6" aria-labelledby="certifications">
      <SectionHead id="certifications" title="Certifications" />
      <ul class="grid gap-3 md:grid-cols-2">
        {certifications.map((c) => (
          <li class="tile flex items-start gap-4 p-6" data-reveal>
            <span class="grid size-12 shrink-0 place-items-center rounded-xl border border-line bg-surface-2 text-signal"><Icon name="award" /></span>
            <div>
              <h3 class="font-bold">{c.link ? <a href={c.link} class="hover:text-signal">{c.title}</a> : c.title}</h3>
              <p class="text-sm text-muted">{c.issuer}{c.year && `, ${c.year}`}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- CONTACT: tile board (references 1 and 5) -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6" aria-labelledby="contact">
    <SectionHead id="contact" title="Contact" intro={profile.openTo} />
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <a href={`mailto:${profile.email}`} class="tile flex flex-col p-6 sm:col-span-2" data-reveal>
        <Icon name="mail" class="size-8 text-signal" />
        <span class="mt-6 text-sm font-semibold text-muted">Email</span>
        <span class="break-all font-display text-2xl font-bold sm:text-3xl">{profile.email}</span>
      </a>
      <a href={profile.linkedin} rel="noopener" class="tile flex flex-col p-6" data-reveal>
        <Icon name="linkedin" class="size-8 text-signal" />
        <span class="mt-6 text-sm font-semibold text-muted">LinkedIn</span>
        <span class="font-display text-2xl font-bold">Connect</span>
      </a>
      <div class="tile flex flex-col items-center justify-center p-6 lg:row-span-2" data-reveal>
        <div class="w-full max-w-44 rounded-lg bg-white p-3" set:html={qrSvg} role="img" aria-label="QR code that opens my LinkedIn profile"></div>
        <p class="mt-3 text-sm font-semibold text-muted">Scan for LinkedIn</p>
      </div>
      <a href={profile.github} rel="noopener" class="tile flex flex-col p-6" data-reveal>
        <Icon name="github" class="size-8 text-signal" />
        <span class="mt-6 text-sm font-semibold text-muted">GitHub</span>
        <span class="font-display text-2xl font-bold">ali-ashraf-it</span>
      </a>
      <a href={`${base}/${profile.cv}`} download class="tile flex flex-col border-signal bg-signal p-6 text-signal-ink sm:col-span-1 lg:col-span-2" data-reveal>
        <Icon name="download" class="size-8" />
        <span class="mt-6 text-sm font-semibold opacity-80">Curriculum vitae</span>
        <span class="font-display text-2xl font-bold">Download CV (PDF)</span>
      </a>
    </div>
  </section>
</Base>

<script>
  // Project filter: shows only tiles of the chosen category.
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const tiles = document.querySelectorAll<HTMLElement>('#project-grid [data-category]');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      tiles.forEach((t) => { t.hidden = !(f === 'All' || t.dataset.category === f); });
    }),
  );
</script>
